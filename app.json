{
  "expo": {
    "name": "TableTime Staff",
    "slug": "clockin",
    "description": "Restaurant staff scheduling, time clock, breaks, requests, and team management in one secure workspace.",
    "version": "1.0.0",
    "scheme": "tabletime",
    "orientation": "portrait",
    "icon": "./assets/tabletime-icon.png",
    "githubUrl": "https://github.com/kushalsrirangam/tabletime",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kushalsrirangam.tabletime",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kushalsrirangam.tabletime",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#14231D",
        "foregroundImage": "./assets/tabletime-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/tabletime-icon.png",
      "bundler": "metro",
      "name": "TableTime Staff",
      "shortName": "TableTime",
      "lang": "en-US",
      "themeColor": "#14231D",
      "backgroundColor": "#F4F3EE",
      "display": "standalone"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14231D",
          "image": "./assets/tabletime-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "987d4ad1-dce6-4e49-b43a-bfbe89c8820c"
      }
    },
    "owner": "kushalkings-team"
  }
}
